---
import "@/styles/global.css";
import { absoluteSiteUrl, site } from "@/lib/site";

type JsonLd = Record<string, unknown>;

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  robots?: string;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
  jsonLd?: JsonLd | JsonLd[];
};

const {
  title = site.name,
  description = site.description,
  canonical,
  image = site.socialImage,
  imageAlt = site.socialImageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  type = "website",
  robots = site.url ? "index, follow" : "noindex, nofollow",
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd = [],
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = absoluteSiteUrl(canonical || Astro.url.pathname);
const socialImageUrl = absoluteSiteUrl(image);
const sitemapUrl = absoluteSiteUrl("/sitemap-index.xml");
const publishedTimeIso = toIsoString(publishedTime);
const modifiedTimeIso = toIsoString(modifiedTime);
const structuredData: JsonLd[] = [
  ...(site.url
    ? [
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "@id": `${site.url}/#website`,
          url: site.url,
          name: site.name,
          description: site.description,
          inLanguage: site.language,
        },
      ]
    : []),
  ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]),
];
const serializedStructuredData = structuredData.map(serializeJsonLd);

function toIsoString(value: Date | string | undefined): string | null {
  if (!value) return null;
  const date = value instanceof Date ? value : new Date(value);
  return Number.isNaN(date.valueOf()) ? null : date.toISOString();
}

function serializeJsonLd(value: JsonLd): string {
  return JSON.stringify(value).replaceAll("<", "\\u003c");
}
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    {sitemapUrl ? <link rel="sitemap" href={sitemapUrl} /> : null}
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    {socialImageUrl ? <meta property="og:image" content={socialImageUrl} /> : null}
    {socialImageUrl ? <meta property="og:image:width" content={String(imageWidth)} /> : null}
    {socialImageUrl ? <meta property="og:image:height" content={String(imageHeight)} /> : null}
    {socialImageUrl ? <meta property="og:image:alt" content={imageAlt} /> : null}
    {type === "article" && publishedTimeIso ? (
      <meta property="article:published_time" content={publishedTimeIso} />
    ) : null}
    {type === "article" && modifiedTimeIso ? (
      <meta property="article:modified_time" content={modifiedTimeIso} />
    ) : null}
    {type === "article" ? tags.map((tag) => <meta property="article:tag" content={tag} />) : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl ? <meta name="twitter:image" content={socialImageUrl} /> : null}
    {socialImageUrl ? <meta name="twitter:image:alt" content={imageAlt} /> : null}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {serializedStructuredData.map((value) => (
      <script type="application/ld+json" set:html={value} is:inline />
    ))}
  </head>
  <body>
    <header class="border-b bg-background/95">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 px-5 py-4">
        <a href="/" class="flex items-center gap-3 font-semibold">
          <img src="/favicon.svg" alt="" class="size-8 rounded-md" />
          <span>{site.name}</span>
        </a>
        <nav class="flex items-center gap-5 text-sm text-muted-foreground">
          {site.nav.map((item) => <a class="hover:text-foreground" href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
