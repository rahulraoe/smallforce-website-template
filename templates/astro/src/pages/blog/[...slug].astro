---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteSiteUrl, site } from "@/lib/site";

export const prerender = true;

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const postUrl = absoluteSiteUrl(`/blog/${post.id}`);
const socialImageUrl = absoluteSiteUrl(post.data.image || site.socialImage);
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate || post.data.pubDate).toISOString(),
  ...(postUrl ? { url: postUrl, mainEntityOfPage: postUrl } : {}),
  ...(socialImageUrl ? { image: [socialImageUrl] } : {}),
  ...(post.data.author
    ? { author: { "@type": "Person", name: post.data.author } }
    : {}),
  publisher: {
    "@type": "Organization",
    name: site.name,
    ...(site.url ? { url: site.url } : {}),
  },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  type="article"
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate || post.data.pubDate}
  tags={post.data.tags}
  jsonLd={articleJsonLd}
>
  <article class="mx-auto w-full max-w-3xl px-5 py-12">
    <a class="text-sm text-muted-foreground hover:text-foreground" href="/blog">Back to blog</a>
    <h1 class="mt-6 text-4xl font-semibold leading-tight">{post.data.title}</h1>
    <p class="mt-3 text-muted-foreground">{post.data.description}</p>
    <p class="mt-3 text-sm text-muted-foreground">
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString(site.language, {
          dateStyle: "long",
        })}
      </time>
      {post.data.updatedDate ? (
        <span>
          {" · Updated "}
          <time datetime={post.data.updatedDate.toISOString()}>
            {post.data.updatedDate.toLocaleDateString(site.language, {
              dateStyle: "long",
            })}
          </time>
        </span>
      ) : null}
    </p>
    <div class="prose mt-8 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
