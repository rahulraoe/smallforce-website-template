---
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout>
  <section class="border-b">
    <div class="mx-auto flex min-h-[calc(100vh-73px)] w-full max-w-6xl items-center px-5 py-14">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-semibold leading-tight tracking-normal sm:text-5xl">
          Replace this starter with the customer's real application.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">
          Astro pages and API routes deploy together as one Worker. Server code
          receives app-scoped SQLite, mutable storage, variables, and secrets
          directly from the SmallForce runtime.
        </p>
        <a
          class="mt-8 inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
          href="/blog"
        >
          View content
        </a>
      </div>
    </div>
  </section>
  <section class="mx-auto grid w-full max-w-6xl gap-4 px-5 py-12 md:grid-cols-3">
    <article class="rounded-xl border bg-card text-card-foreground shadow-sm">
      <div class="flex flex-col gap-1.5 p-6">
        <h2 class="font-semibold leading-none">Pages</h2>
        <p class="text-sm text-muted-foreground">
          Prerender public content and render dynamic routes on demand.
        </p>
      </div>
    </article>
    <article class="rounded-xl border bg-card text-card-foreground shadow-sm">
      <div class="flex flex-col gap-1.5 p-6">
        <h2 class="font-semibold leading-none">Database</h2>
        <p class="text-sm text-muted-foreground">
          Use parameterized SQLite through env.DB in server code.
        </p>
      </div>
    </article>
    <article class="rounded-xl border bg-card text-card-foreground shadow-sm">
      <div class="flex flex-col gap-1.5 p-6">
        <h2 class="font-semibold leading-none">Storage</h2>
        <p class="text-sm text-muted-foreground">
          Use env.STORAGE for app-scoped mutable files and quotas.
        </p>
      </div>
    </article>
  </section>
</BaseLayout>
