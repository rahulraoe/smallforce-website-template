{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SmallForce App Template Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["appId", "deploymentId", "name", "slug", "type", "capabilities", "backendUrl", "runtime", "deploymentUrl"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "appId": {
      "type": "string",
      "description": "SmallForce app id returned by smallforce app init. Empty before first app creation."
    },
    "deploymentId": {
      "type": "string",
      "description": "Latest SmallForce deployment id returned by smallforce app deploy. Empty before first deployment."
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "type": {
      "enum": ["static", "fullstack"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["db"],
      "properties": {
        "db": {
          "type": "boolean"
        }
      }
    },
    "backendUrl": {
      "type": "string",
      "format": "uri"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dbQueryPath", "storageUploadPath", "storageObjectPath", "storageListPath"],
      "properties": {
        "dbQueryPath": {
          "type": "string"
        },
        "storageUploadPath": {
          "type": "string"
        },
        "storageObjectPath": {
          "type": "string"
        },
        "storageListPath": {
          "type": "string"
        }
      }
    },
    "deploymentUrl": {
      "type": "string"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "outputDirectory"],
      "properties": {
        "command": {
          "type": "string"
        },
        "outputDirectory": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "db": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "id": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "url": {
          "type": ["string", "null"]
        },
        "errorMessage": {
          "type": ["string", "null"]
        }
      }
    },
    "updatedAt": {
      "type": "string"
    }
  }
}
