---
import { getSmallForceConfig } from "@/lib/smallforce";

const config = getSmallForceConfig();
const dbLabel = config.capabilities.db ? "DB requested" : "No DB";
const idsReady = Boolean(config.appId && config.deploymentId);
---

<div class="inline-flex flex-wrap items-center gap-2 rounded-lg border bg-card px-3 py-2 text-xs text-muted-foreground">
  <span class="font-medium text-foreground">{config.type}</span>
  <span>{dbLabel}</span>
  <span>{idsReady ? "deployment linked" : "not deployed yet"}</span>
</div>
