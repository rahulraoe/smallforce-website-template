---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const prerender = true;

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((post) => !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto w-full max-w-3xl px-5 py-12">
    <a class="text-sm text-muted-foreground hover:text-foreground" href="/blog">Back to blog</a>
    <h1 class="mt-6 text-4xl font-semibold leading-tight">{post.data.title}</h1>
    <p class="mt-3 text-muted-foreground">{post.data.description}</p>
    <div class="prose mt-8 max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
