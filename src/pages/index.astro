---
import { Button } from "@/components/ui/button";
import { Card, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="border-b">
    <div class="mx-auto flex min-h-[calc(100vh-73px)] w-full max-w-6xl items-center px-5 py-14">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-semibold leading-tight tracking-normal sm:text-5xl">
          Build the customer's website, content hub, or fullstack workflow here.
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-muted-foreground">
          This Astro template is ready for Tailwind CSS, shadcn/ui, content collections, server routes, and SmallForce backend-mediated runtime helpers.
        </p>
        <Button className="mt-8" asChild>
          <a href="/blog">View content</a>
        </Button>
      </div>
    </div>
  </section>
  <section class="mx-auto grid w-full max-w-6xl gap-4 px-5 py-12 md:grid-cols-3">
    <Card>
      <CardHeader>
        <CardTitle>Static</CardTitle>
        <CardDescription>Fast SEO pages with prerendered HTML.</CardDescription>
      </CardHeader>
    </Card>
    <Card>
      <CardHeader>
        <CardTitle>Content</CardTitle>
        <CardDescription>Typed Markdown collections for blogs, guides, and FAQs.</CardDescription>
      </CardHeader>
    </Card>
    <Card>
      <CardHeader>
        <CardTitle>Fullstack</CardTitle>
        <CardDescription>Server routes can call the SmallForce backend for DB access.</CardDescription>
      </CardHeader>
    </Card>
  </section>
</BaseLayout>
