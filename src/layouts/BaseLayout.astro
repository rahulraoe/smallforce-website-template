---
import "@/styles/global.css";
import { absoluteSiteUrl, site } from "@/lib/site";

type Props = {
  title?: string;
  description?: string;
};

const { title = site.name, description = site.description } = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = absoluteSiteUrl(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="border-b bg-background/95">
      <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 px-5 py-4">
        <a href="/" class="flex items-center gap-3 font-semibold">
          <img src="/favicon.svg" alt="" class="size-8 rounded-md" />
          <span>{site.name}</span>
        </a>
        <nav class="flex items-center gap-5 text-sm text-muted-foreground">
          {site.nav.map((item) => <a class="hover:text-foreground" href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
